# ======================
# Telegram API Credentials
# Get from https://my.telegram.org
# ======================
API_ID=12345678
API_HASH=your_api_hash_here

# ======================
# Bot Token (from @BotFather)
# ======================
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ======================
# Session Name
# ======================
SESSION_NAME=tg_auto_bot

# ======================
# Owner User ID (Main Owner)
# ======================
OWNER_ID=123456789

# ======================
# Log Chat / Group ID (Approve/Reject buttons yahan aayenge)
# ======================
LOG_CHAT_ID=-1001234567890

# ======================
# Force Subscribe Channel (user must join this)
# Example: @YourChannel or -100xxxxxxxxxx
# ======================
FORCE_SUB_CHANNEL=@YourChannelUsername
FORCE_SUB_CHANNEL_ID=-1001234567890

# ======================
# Support Channel / Group (shown in /start)
# ======================
SUPPORT_CHANNEL=@YourSupportChannel

# ======================
# Auto React Chats (comma separated)
# ======================
AUTO_REACT_CHATS=-1001111111111,-1002222222222

# ======================
# Default reaction emojis
# ======================
REACT_EMOJIS=👍 ❤️ 🔥 👏 😍

# ======================
# Default Clone Target
# ======================
DEFAULT_CLONE_TARGET=-1003333333333

# ======================
# Reaction Delay (seconds)
# ======================
REACT_DELAY_MIN=1.0
REACT_DELAY_MAX=3.5
